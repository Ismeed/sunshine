// ============================================================================
// Sunshine Gadgets POS - Firestore security rules
// Paste this whole file into Firebase Console -> Firestore Database -> Rules,
// replacing the default, then Publish.
//
// Every device signs in anonymously on load (see js/sync.js) purely so these
// rules can require request.auth != null - it's not per-user identity, every
// anonymous sign-in is granted the same access. Fine for a small
// trusted-staff internal tool where the three collections below are the
// entire database, but it does mean any device that loads the app can
// read/write everything. Tightening this into real per-staff identity
// (Firebase Auth with email/password or phone, rules keyed off
// request.auth.uid) is a natural future step if the shop grows past
// "everyone here is trusted".
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }

    // Everything else stays locked - explicit deny by omission.
  }
}
